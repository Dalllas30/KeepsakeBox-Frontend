{
  "name": "keepsake-box",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:with-json-server": "concurrently \"npm run json-server\" \"npm run start\"",
    "json-server": "json-server --watch db.json --port 3000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:KeepsakeBox": "node dist/KeepsakeBox/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "21.2.6",
    "@angular/compiler": "21.2.6",
    "@angular/core": "21.2.6",
    "@angular/forms": "21.2.6",
    "@angular/localize": "21.2.6",
    "@angular/platform-browser": "21.2.6",
    "@angular/platform-server": "21.2.6",
    "@angular/router": "21.2.6",
    "@angular/ssr": "21.2.6",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "crypto-js": "^4.2.0",
    "express": "^5.1.0",
    "ng2-img-max": "^2.2.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.5",
    "@angular/cli": "21.2.5",
    "@angular/compiler-cli": "21.2.6",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.17.19",
    "concurrently": "^8.2.0",
    "json-server": "^0.17.4",
    "typescript": "~5.9.2"
  }
}
